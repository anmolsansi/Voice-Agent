# CheckIn Care local development environment.
# Copy this file to .env or .env.local and replace placeholders with real local secrets.
# Do not commit .env, .env.local, production credentials, or PHI.

# Runtime URLs
APP_URL=http://127.0.0.1:3000
INTAKE_API_BASE_URL=http://127.0.0.1:3001
FRONTEND_PORT=3000
BACKEND_PORT=3001
APP_NAME=voice-agent-backend
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL persistence and migrations
DATABASE_URL=postgres://postgres:postgres@localhost:5432/voice_agent_dev
PGSSL=false
ALLOW_MEMORY_FALLBACK=false

# Staff authentication
# legacy = shared local pilot access token; jwt = per-user staff login once JWT schema/tooling is available.
STAFF_AUTH_MODE=legacy
JWT_SECRET=replace-with-a-long-random-jwt-secret
STAFF_ACCESS_TOKEN=replace-with-a-long-random-staff-access-code

# Optional defaults consumed by npm run db:seed-staff.
STAFF_USER_EMAIL=admin@example.com
STAFF_USER_PASSWORD=change-me-before-use
STAFF_USER_DISPLAY_NAME=Clinic Admin
STAFF_USER_ROLE=admin

# Telephony provider configuration
# Use mock locally. Use twilio/telnyx only when testing real outbound calls or provider webhooks.
TELEPHONY_PROVIDER=mock
TELEPHONY_ACCOUNT_SID=AC00000000000000000000000000000000
TELEPHONY_AUTH_TOKEN=replace-with-local-telephony-auth-token
TELEPHONY_API_KEY=replace-with-local-telephony-api-key
TELEPHONY_FROM_NUMBER=+15555550100
WEBHOOK_SIGNING_SECRET=replace-with-local-webhook-signing-secret
WEBHOOK_TUNNEL_URL=http://127.0.0.1:3001

# AI extraction / LLM provider
AI_PROVIDER=mock
AI_PROVIDER_API_KEY=replace-with-local-ai-provider-key
AI_MODEL=mock-intake-extractor

# Text-to-speech and speech-to-text settings
TTS_PROVIDER=web-speech
TTS_VOICE=default
TTS_LANGUAGE=en-US
STT_PROVIDER=web-speech
STT_MODEL=browser-default
STT_LANGUAGE=en-US

# Recording URL storage controls. Keep false unless a provider and policy allow storing URLs.
STORE_RECORDING_URLS=false
PROVIDER_RECORDING_URLS_ENABLED=false

# Feature flags
FEATURE_VOICE_INTAKE=true
FEATURE_CALL_SIMULATION=true
FEATURE_WEBHOOK_SIMULATION=true

# Public client flags must use the framework prefix and must never contain secrets.
NEXT_PUBLIC_ENABLE_VOICE_PROTOTYPE=true

# Voice Agent foundation settings used by the framework-neutral service modules.
VOICE_PROVIDER=sandbox
VOICE_PROVIDER_ACCOUNT_ID=replace-with-provider-account-id
VOICE_PROVIDER_API_KEY=replace-with-provider-api-key
VOICE_PROVIDER_WEBHOOK_SECRET=replace-with-webhook-secret
VOICE_PROVIDER_CALLER_ID=+15555550100
AI_REALTIME_MODEL=gpt-realtime
AI_SUMMARY_MODEL=gpt-4.1-mini
VOICE_DEFAULT_LANGUAGE=en-US
VOICE_DEFAULT_NAME=alloy
VOICE_SILENCE_TIMEOUT_MS=5000
VOICE_MAX_CLARIFICATION_ATTEMPTS=2
SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=America/Los_Angeles
SCHEDULED_CALL_BATCH_SIZE=25
CALL_RETRY_DELAY_MINUTES=30
CALL_MAX_ATTEMPTS=3
FEATURE_REALTIME_CALLS=false
FEATURE_CARE_TEAM_DASHBOARD=true
FEATURE_ANALYTICS=false
FEATURE_CSV_EXPORT=false
