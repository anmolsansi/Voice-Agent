# App
APP_ENV=development
APP_URL=http://localhost:3000
PUBLIC_APP_NAME="CheckIn Care Voice Agent"

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/checkin_care

# Auth
AUTH_SECRET=replace-with-local-secret
AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Voice provider
VOICE_PROVIDER=sandbox
VOICE_PROVIDER_ACCOUNT_ID=replace-with-provider-account-id
VOICE_PROVIDER_API_KEY=replace-with-provider-api-key
VOICE_PROVIDER_WEBHOOK_SECRET=replace-with-webhook-secret
VOICE_PROVIDER_CALLER_ID=+15555550100

# AI/realtime voice
AI_PROVIDER=openai
AI_REALTIME_MODEL=gpt-realtime
AI_SUMMARY_MODEL=gpt-4.1-mini
AI_API_KEY=replace-with-local-api-key
VOICE_DEFAULT_LANGUAGE=en-US
VOICE_DEFAULT_NAME=alloy
VOICE_SILENCE_TIMEOUT_MS=5000
VOICE_MAX_CLARIFICATION_ATTEMPTS=2

# Scheduling and worker behavior
SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=America/Los_Angeles
SCHEDULED_CALL_BATCH_SIZE=25
CALL_RETRY_DELAY_MINUTES=30
CALL_MAX_ATTEMPTS=3

# Feature flags
FEATURE_REALTIME_CALLS=false
FEATURE_CARE_TEAM_DASHBOARD=true
FEATURE_ANALYTICS=false
FEATURE_CSV_EXPORT=false
