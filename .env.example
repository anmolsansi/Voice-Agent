# PostgreSQL connection for local development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/voice_agent_dev

# Optional SSL toggle for hosted/shared environments
PGSSL=false

# Frontend (Next.js) port used by `npm run dev:frontend` / `npm run start:frontend`
FRONTEND_PORT=3000

# Backend API port used by `npm run dev:backend` / `npm run start:backend`
BACKEND_PORT=3001

# Frontend-to-backend base URL. Keep this aligned with BACKEND_PORT for local development.
INTAKE_API_BASE_URL=http://127.0.0.1:3001

# Optional backend service name
APP_NAME=voice-agent-backend

# Staff authentication mode during the auth migration.
# - legacy: shared STAFF_ACCESS_TOKEN pilot flow
# - jwt: per-user JWT staff login flow
STAFF_AUTH_MODE=legacy

# JWT signing secret used when STAFF_AUTH_MODE=jwt.
# Use a long, random secret in real deployments.
JWT_SECRET=replace-with-a-long-random-jwt-secret

# Legacy shared pilot-grade staff access code for PHI-bearing staff pages and privileged APIs.
# Keep this set only while running STAFF_AUTH_MODE=legacy or during rollout validation.
STAFF_ACCESS_TOKEN=replace-with-a-long-random-staff-access-code

# Optional defaults for `npm run db:seed-staff` when creating the first staff login.
# You can also pass these as CLI args, for example:
# npm run db:seed-staff -- --email admin@example.com --password 'ChangeMe123!' --display_name 'Clinic Admin' --role admin
STAFF_USER_EMAIL=admin@example.com
STAFF_USER_PASSWORD=change-me-before-use
STAFF_USER_DISPLAY_NAME=Clinic Admin
STAFF_USER_ROLE=admin
